rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function professional(role, department) {
      return signedIn() && exists(/databases/$(database)/documents/access/$(request.auth.uid))
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.role == role
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.departmentId == department;
    }
    // Este prototipo tiene una sola dependencia; reportes anteriores pertenecen a ella.
    function staff() { return professional('admin', 'zipaquira-bienestar-animal'); }
    function bounded() { return request.query.limit != null && request.query.limit <= 20; }
    function text(value, max) { return value is string && value.size() <= max; }
    function territory(value) {
      return value in ['comuna-1', 'comuna-2', 'comuna-3', 'comuna-4'];
    }
    function petValid(d) {
      return d.keys().hasAll(['ownerId','name','species','breed','sex','age','color',
        'territoryId','status','photoKey','qrCode','createdAt','updatedAt'])
        && d.keys().hasOnly(['ownerId','name','species','breed','sex','age','color',
        'territoryId','status','photoKey','qrCode','createdAt','updatedAt'])
        && text(d.ownerId, 128) && d.ownerId.size() > 0
        && text(d.name, 80) && d.name.size() > 0
        && d.species in ['Perro','Gato']
        && text(d.breed, 80) && d.breed.size() > 0
        && d.sex in ['Hembra','Macho','No determinado']
        && text(d.age, 40) && d.age.size() > 0
        && text(d.color, 80) && d.color.size() > 0
        && territory(d.territoryId)
        && d.status in ['Con responsable','En adopción','En custodia']
        && d.photoKey in ['', 'luna', 'michi', 'rocco', 'nina']
        && d.qrCode is string && d.qrCode.matches('^ZPQ-[A-Z0-9]{8}$')
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }
    function reportValid(d) {
      return d.keys().hasAll(['ownerId','petId','petName','type','species','territoryId',
        'description','status','createdAt','updatedAt'])
        && d.keys().hasOnly(['ownerId','petId','petName','type','species','territoryId',
        'description','status','createdAt','updatedAt'])
        && text(d.ownerId, 128) && d.ownerId.size() > 0
        && text(d.petId, 128) && text(d.petName, 80)
        && d.type in ['Pérdida','Encontrado','Avistamiento']
        && d.species in ['Perro','Gato']
        && territory(d.territoryId)
        && text(d.description, 2000) && d.description.size() > 0
        && d.status in ['Abierto','Resuelto','Cerrado']
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email','role','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['email','role','createdAt','updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'citizen'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Cambios de rol y contacto solo mediante Admin SDK / consola de confianza.
      allow update, delete: if false;
    }

    match /pets/{petId} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 1000;
      allow create: if signedIn() && petValid(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'Con responsable'
        && request.resource.data.photoKey == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && (resource.data.ownerId == request.auth.uid || staff())
        && petValid(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','species','breed','sex','age','color','territoryId','status','updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow get: if signedIn() && (resource.data.ownerId == request.auth.uid || staff());
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 1000
        && (resource.data.ownerId == request.auth.uid || staff());
      allow create: if signedIn() && reportValid(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && (request.resource.data.petId == '' ||
          get(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.ownerId == request.auth.uid)
        && request.resource.data.status == 'Abierto'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && (resource.data.ownerId == request.auth.uid || staff())
        && reportValid(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && ((staff() && request.resource.data.status == 'Cerrado'
          && getAfter(/databases/$(database)/documents/cases/$(reportId)).data.status == 'Cerrado')
          || (resource.data.ownerId == request.auth.uid && resource.data.status == 'Abierto'
            && request.resource.data.status == 'Resuelto'));
      allow delete: if false;
    }

    match /access/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId ||
        (staff() && resource.data.departmentId == 'zipaquira-bienestar-animal' && resource.data.role == 'vet'));
      allow list: if staff() && bounded() && resource.data.departmentId == 'zipaquira-bienestar-animal'
        && resource.data.role == 'vet';
      // Aprobar, revocar o cambiar roles exige consola de confianza / Admin SDK.
      allow write: if false;
    }
    function caseReader(d) {
      return signedIn() && (d.ownerId == request.auth.uid || professional('admin', d.departmentId)
        || (professional('vet', d.departmentId) && d.vetId == request.auth.uid));
    }
    function assignedVet(d) {
      return professional('vet', d.departmentId) && d.vetId == request.auth.uid;
    }
    function caseValid(d) {
      return d.keys().hasAll(['reportId','ownerId','petId','petName','species','territoryId','departmentId',
        'vetId','status','outcome','lastRecordId','version','updatedBy','createdAt','updatedAt'])
        && d.keys().hasOnly(['reportId','ownerId','petId','petName','species','territoryId','departmentId',
        'vetId','status','outcome','lastRecordId','version','updatedBy','createdAt','updatedAt'])
        && d.departmentId == 'zipaquira-bienestar-animal'
        && d.status in ['Revisado','Asignado','Atendido','Cerrado']
        && text(d.vetId,128) && text(d.outcome,1000) && text(d.lastRecordId,128)
        && d.version is int && d.version > 0 && d.updatedBy == request.auth.uid
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function eventMatches(id, d) {
      let e = getAfter(/databases/$(database)/documents/cases/$(id)/history/$(string(d.version))).data;
      return e.actorId == request.auth.uid && e.status == d.status
        && e.version == d.version && e.vetId == d.vetId && e.createdAt == request.time;
    }
    function validAssignment(d) {
      let vet = get(/databases/$(database)/documents/access/$(d.vetId)).data;
      return vet.role == 'vet' && vet.active == true && vet.departmentId == d.departmentId;
    }
    match /cases/{caseId} {
      // El propietario puede consultar también un caso aún inexistente por ID de su reporte.
      allow get: if (resource != null && caseReader(resource.data)) ||
        (!exists(/databases/$(database)/documents/cases/$(caseId)) && (staff() ||
          (signedIn() && get(/databases/$(database)/documents/reports/$(caseId)).data.ownerId == request.auth.uid)));
      allow list: if bounded() && caseReader(resource.data);
      allow create: if staff() && caseValid(request.resource.data)
        && request.resource.data.reportId == caseId
        && request.resource.data.ownerId == get(/databases/$(database)/documents/reports/$(caseId)).data.ownerId
        && request.resource.data.petId == get(/databases/$(database)/documents/reports/$(caseId)).data.petId
        && request.resource.data.petName == get(/databases/$(database)/documents/reports/$(caseId)).data.petName
        && request.resource.data.species == get(/databases/$(database)/documents/reports/$(caseId)).data.species
        && request.resource.data.territoryId == get(/databases/$(database)/documents/reports/$(caseId)).data.territoryId
        && get(/databases/$(database)/documents/reports/$(caseId)).data.status == 'Abierto'
        && request.resource.data.status == 'Revisado' && request.resource.data.vetId == ''
        && request.resource.data.outcome == '' && request.resource.data.lastRecordId == ''
        && request.resource.data.version == 1 && request.resource.data.createdAt == request.time
        && eventMatches(caseId, request.resource.data);
      allow update: if caseValid(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'vetId','status','outcome','lastRecordId','version','updatedBy','updatedAt'])
        && request.resource.data.version == resource.data.version + 1
        && eventMatches(caseId, request.resource.data)
        && ((professional('admin', resource.data.departmentId)
          && request.resource.data.lastRecordId == resource.data.lastRecordId
          && ((resource.data.status in ['Revisado','Asignado'] && request.resource.data.status == 'Asignado'
            && validAssignment(request.resource.data) && request.resource.data.outcome == resource.data.outcome)
          || (resource.data.status in ['Revisado','Atendido'] && request.resource.data.status == 'Cerrado'
            && request.resource.data.vetId == resource.data.vetId && request.resource.data.outcome.size() > 0
            && getAfter(/databases/$(database)/documents/reports/$(caseId)).data.status == 'Cerrado')))
        || (assignedVet(resource.data) && resource.data.status in ['Asignado','Atendido']
          && request.resource.data.status == 'Atendido'
          && request.resource.data.vetId == resource.data.vetId && request.resource.data.outcome == resource.data.outcome
          && request.resource.data.lastRecordId != resource.data.lastRecordId
          && getAfter(/databases/$(database)/documents/cases/$(caseId)/clinicalRecords/$(request.resource.data.lastRecordId)).data.authorId == request.auth.uid
          && getAfter(/databases/$(database)/documents/cases/$(caseId)/clinicalRecords/$(request.resource.data.lastRecordId)).data.createdAt == request.time));
      allow delete: if false;
      match /history/{eventId} {
        allow get: if caseReader(get(/databases/$(database)/documents/cases/$(caseId)).data);
        allow list: if bounded() && caseReader(get(/databases/$(database)/documents/cases/$(caseId)).data);
        allow create: if signedIn()
          && request.resource.data.keys().hasAll(['actorId','status','version','vetId','createdAt'])
          && request.resource.data.keys().hasOnly(['actorId','status','version','vetId','createdAt'])
          && request.resource.data.actorId == request.auth.uid && request.resource.data.createdAt == request.time
          && eventId == string(request.resource.data.version)
          && getAfter(/databases/$(database)/documents/cases/$(caseId)).data.version == request.resource.data.version
          && getAfter(/databases/$(database)/documents/cases/$(caseId)).data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/cases/$(caseId)).data.updatedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/cases/$(caseId)).data.status == request.resource.data.status
          && getAfter(/databases/$(database)/documents/cases/$(caseId)).data.vetId == request.resource.data.vetId;
        allow update, delete: if false;
      }
      match /clinicalRecords/{recordId} {
        allow get: if assignedVet(get(/databases/$(database)/documents/cases/$(caseId)).data);
        allow list: if bounded() && assignedVet(get(/databases/$(database)/documents/cases/$(caseId)).data);
        allow create: if assignedVet(get(/databases/$(database)/documents/cases/$(caseId)).data)
          && get(/databases/$(database)/documents/cases/$(caseId)).data.status in ['Asignado','Atendido']
          && request.resource.data.keys().hasAll(['authorId','examination','care','followUp','createdAt'])
          && request.resource.data.keys().hasOnly(['authorId','examination','care','followUp','createdAt'])
          && request.resource.data.authorId == request.auth.uid && request.resource.data.createdAt == request.time
          && text(request.resource.data.examination,2000) && request.resource.data.examination.size() > 0
          && text(request.resource.data.care,2000) && request.resource.data.care.size() > 0
          && text(request.resource.data.followUp,1000)
          && getAfter(/databases/$(database)/documents/cases/$(caseId)).data.lastRecordId == recordId
          && getAfter(/databases/$(database)/documents/cases/$(caseId)).data.status == 'Atendido';
        allow update, delete: if false;
      }
    }
    match /territories/{territoryId} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
